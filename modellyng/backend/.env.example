# ==============================================================================
# MODELLYNG WEB — BACKEND ENVIRONMENT CONFIGURATION
# Letakkan berkas ini sebagai '.env' di dalam folder: modellyng/backend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API KEYS AI (LLM Gatekeeper & 11 Parameter Extraction)
# ------------------------------------------------------------------------------
# GROQ API KEY: Digunakan sebagai model utama (Llama-3.3-70B & Gatekeeper kecepatan tinggi)
# Dapatkan API Key gratis di: https://console.groq.com/keys
GROQ_API_KEY="gsk_masukkan_api_key_groq_anda_disini"

# GEMINI API KEY: Digunakan sebagai penyedia AI alternatif / cadangan (Gemini 1.5 Flash)
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy_masukkan_api_key_gemini_anda_disini"

# ------------------------------------------------------------------------------
# 2. BASIS DATA & REDIS (Port Khusus modellying-web)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:modellying_web_password@127.0.0.1:28022/postgres"
REDIS_URL="redis://127.0.0.1:6381/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6381/1"

# ------------------------------------------------------------------------------
# 3. PENYIMPANAN FILE PDF (Storage)
# ------------------------------------------------------------------------------
# Folder lokal tempat PDF asli disimpan secara privat
# STORAGE_LOCAL_DIR="d:/Koding/Modellying Web By Github/modellyng/backend/storage_files"
